{
  "id": "demo-shop",
  "name": "Nimbus Supply",
  "version": "2.0.0",
  "description": "Configure a Nimbus Studio, put it in the bag, apply a coupon and review the order \u2014 by driving the store's own controls. The site itself implements no WebMCP.",
  "category": "commerce",
  "author": "Liha WebMCP Adapter",
  "verifiedAt": "2026-09-03",
  "origins": [
    "http://localhost:5274",
    "http://127.0.0.1:5274",
    "https://demo-shop.liha.review"
  ],
  "tools": [
    {
      "name": "view_configure",
      "title": "Open the configurator",
      "description": "Open the page where the machine is configured, and report what is currently selected.",
      "capability": "INTERACT",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='config-summary']"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-total']",
          "as": "price"
        }
      ]
    },
    {
      "name": "read_configuration",
      "title": "Read the configuration",
      "description": "Return the Nimbus Studio currently configured \u2014 chip, memory, storage \u2014 and what it costs. Reads the configure page as it stands; open it first with view_configure.",
      "capability": "READ",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "steps": [
        {
          "type": "waitFor",
          "selector": "[data-testid='config-summary']"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-chip']",
          "as": "chip"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-memory']",
          "as": "memory"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-storage']",
          "as": "storage"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-total']",
          "as": "price"
        }
      ]
    },
    {
      "name": "choose_chip",
      "title": "Choose the chip",
      "description": "Pick which chip the machine is built around. The price updates as soon as it is set.",
      "capability": "WRITE",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chip": {
            "type": "string",
            "description": "Which chip to fit",
            "enum": [
              "Nimbus 3",
              "Nimbus 3 Pro",
              "Nimbus 3 Max"
            ]
          }
        },
        "required": [
          "chip"
        ]
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='config-chip']"
        },
        {
          "type": "select",
          "selector": "[data-testid='config-chip']",
          "value": "{{chip}}"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-chip']",
          "as": "chip"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-total']",
          "as": "price"
        }
      ]
    },
    {
      "name": "choose_memory",
      "title": "Choose the memory",
      "description": "Pick how much unified memory the machine is built with.",
      "capability": "WRITE",
      "inputSchema": {
        "type": "object",
        "properties": {
          "memory": {
            "type": "string",
            "description": "How much memory to fit",
            "enum": [
              "32GB",
              "64GB",
              "128GB"
            ]
          }
        },
        "required": [
          "memory"
        ]
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='config-memory']"
        },
        {
          "type": "select",
          "selector": "[data-testid='config-memory']",
          "value": "{{memory}}"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-memory']",
          "as": "memory"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-total']",
          "as": "price"
        }
      ]
    },
    {
      "name": "choose_storage",
      "title": "Choose the storage",
      "description": "Pick how much storage the machine is built with.",
      "capability": "WRITE",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storage": {
            "type": "string",
            "description": "How much storage to fit",
            "enum": [
              "512GB SSD",
              "1TB SSD",
              "2TB SSD"
            ]
          }
        },
        "required": [
          "storage"
        ]
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='config-storage']"
        },
        {
          "type": "select",
          "selector": "[data-testid='config-storage']",
          "value": "{{storage}}"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-storage']",
          "as": "storage"
        },
        {
          "type": "readText",
          "selector": "[data-testid='config-total']",
          "as": "price"
        }
      ]
    },
    {
      "name": "add_to_bag",
      "title": "Add the configuration to the bag",
      "description": "Put the machine as currently configured into the bag, then report what the bag holds.",
      "capability": "WRITE",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/"
        },
        {
          "type": "waitFor",
          "selector": "[data-action='add-to-bag']"
        },
        {
          "type": "click",
          "selector": "[data-action='add-to-bag']"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='bag-items'] li"
        },
        {
          "type": "readList",
          "selector": "[data-testid='bag-items'] li",
          "as": "bag"
        },
        {
          "type": "readText",
          "selector": "[data-testid='bag-total']",
          "as": "total"
        }
      ]
    },
    {
      "name": "view_bag",
      "title": "View the bag",
      "description": "Open the bag and return what is in it and what it comes to.",
      "capability": "INTERACT",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/bag"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='bag-panel']"
        },
        {
          "type": "readList",
          "selector": "[data-testid='bag-items'] li",
          "as": "items"
        },
        {
          "type": "readText",
          "selector": "[data-testid='bag-total']",
          "as": "total"
        }
      ]
    },
    {
      "name": "apply_coupon",
      "title": "Apply a coupon",
      "description": "Enter a coupon code on the bag and report whether the store accepted it, with the total that results.",
      "capability": "WRITE",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The coupon code to try"
          }
        },
        "required": [
          "code"
        ]
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/bag"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='coupon-form'] [name='coupon']"
        },
        {
          "type": "fill",
          "selector": "[data-testid='coupon-form'] [name='coupon']",
          "value": "{{code}}"
        },
        {
          "type": "click",
          "selector": "[data-action='apply-coupon']"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='coupon-status']"
        },
        {
          "type": "readText",
          "selector": "[data-testid='coupon-status']",
          "as": "coupon_status"
        },
        {
          "type": "readText",
          "selector": "[data-testid='bag-total']",
          "as": "total"
        }
      ]
    },
    {
      "name": "review_order",
      "title": "Open the order review",
      "description": "Move the bag to the order review and report what would be ordered. It stops there: this store has no payment step, so there is nothing here to pay with.",
      "capability": "INTERACT",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "steps": [
        {
          "type": "navigate",
          "path": "/bag"
        },
        {
          "type": "waitFor",
          "selector": "[data-action='review-order']"
        },
        {
          "type": "click",
          "selector": "[data-action='review-order']"
        },
        {
          "type": "waitFor",
          "selector": "[data-testid='order-review']"
        },
        {
          "type": "readText",
          "selector": "[data-testid='review-total']",
          "as": "total"
        }
      ]
    }
  ]
}
